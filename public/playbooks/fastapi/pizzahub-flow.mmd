sequenceDiagram
    participant Client
    participant Router as ordini_router
    participant Svc as OrdineService
    participant Repo as PizzaRepository
    participant DB as Database (SQLAlchemy)

    Client->>Router: POST /api/ordini
    Router->>Svc: crea_ordine(dto)
    Svc->>Repo: trova_per_id(pizza_id)
    Repo->>DB: SELECT
    DB-->>Repo: Pizza
    Repo-->>Svc: Pizza
    Svc->>Svc: applica le regole di dominio
    Svc->>Repo: salva(ordine)
    Repo->>DB: INSERT
    Svc-->>Router: OrdineDto
    Router-->>Client: 201 Created
