mindmap
  root((Rust vs Python))
    Execution["⚙️ Esecuzione"]
      Rust["Compilato → binario nativo"]
      Python["Interpretato → bytecode"]
    Memory["🧠 Memoria"]
      Rust["Ownership system<br/>Zero-cost, deterministico"]
      Python["Garbage Collector<br/>Automatico, pause"]
    Types["🏷️ Tipi"]
      Rust["Statici, strict<br/>let x: i32 = 5"]
      Python["Dinamici, flessibili<br/>x = 5; x = 'ciao'"]
    Safety["🛡️ Sicurezza"]
      Rust["Compile-time<br/>No null, no data race"]
      Python["Runtime<br/>TypeError, AttributeError"]
    ErrorHandling["⚠️ Errori"]
      Rust["Result&lt;T,E&gt; + ?<br/>Errori come valori"]
      Python["try/except/raise<br/>Eccezioni"]
    Performance["⚡ Performance"]
      Rust["Pari a C/C++<br/>Zero-cost abstractions"]
      Python["10-100x più lento<br/>CPython overhead"]
    LearningCurve["📈 Curva Apprendimento"]
      Rust["Ripida<br/>Borrow checker, lifetimes"]
      Python["Dolce<br/>Leggibile, permissivo"]
    When["🎯 Quando usarlo"]
      Rust["Sistemi, embedded, WASM<br/>Performance + safety"]
      Python["Script, AI/ML, web<br/>Prototipazione rapida"]
